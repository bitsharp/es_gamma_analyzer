# Local development example
# Copy this file to .env and fill in real values.

# MongoDB Atlas (recommended)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTERHOST/es_gamma_analyzer?retryWrites=true&w=majority

# Optional
MONGODB_DB=es_gamma_analyzer
MONGODB_PRESSURE_COLLECTION=pressure_points

# Optional: where to store login/logout events
MONGODB_LOGIN_COLLECTION=login_sessions

# Optional: where to store the last analyzed PDF per user
MONGODB_LAST_ANALYSIS_COLLECTION=last_analysis

# Optional: TTL for login session logs (days). Default: 90
LOGIN_SESSIONS_TTL_DAYS=90

# Optional: change Flask port (default in app.py is 5005)
# PORT=5005

# Google OAuth (required for web dashboard login)
# Create an OAuth Client (Web application) in Google Cloud Console.
# Authorized redirect URI (local): http://localhost:5005/auth/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Flask session secret (required) — generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-32-byte-random-hex-string

# Optional: restrict admin pages to these emails (comma-separated)
# If empty, any authenticated user can access /admin locally.
# On Vercel (VERCEL=1), the allowlist is REQUIRED.
ADMIN_EMAILS=luca.taurisano@bitsharp.it

# Financial Modeling Prep API key. Fonte UNICA dei fondamentali dello screener
# (fondamentali, ricerca tipo-ahead e P/E forward storico): senza questa chiave
# lo screener resta vuoto, non c'è più il fallback su yfinance. Serve il piano
# Ultimate per i mercati non-US (IT/DE/NL/ES/IN).
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# --- Interactive Brokers: snapshot posizioni/ordini + alert earnings ---------
# IBKR non è interrogabile da qui (la Client Portal API vuole un gateway locale
# con login giornaliero). Lo snapshot lo scrive un job esterno via POST
# /api/ibkr/sync, che si autentica con questo bearer token. Senza token
# l'endpoint di scrittura resta chiuso: generane uno con
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
IBKR_SYNC_TOKEN=

# Proprietario dello snapshot quando la sync non lo indica. Deve coincidere con
# l'email Google con cui si fa login, altrimenti la pagina portafoglio non lo
# trova. Se vuoto usa il primo indirizzo di ADMIN_EMAILS.
IBKR_SYNC_USER_EMAIL=

# Bot Telegram per la notifica delle 20:00. Il token lo dà @BotFather; il
# chat_id si legge da https://api.telegram.org/bot<TOKEN>/getUpdates dopo aver
# scritto un messaggio qualsiasi al bot. Se mancano, la sync funziona lo stesso
# e la notifica Telegram viene semplicemente saltata.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opzionale: mappa esplicita simbolo IBKR → simbolo FMP, per i ticker che
# nessuna regola per suffisso può indovinare. IBKR numera parte dei ticker di
# Borsa Italiana (Amplifon è AMP2, FMP la chiama AMP.MI). AMP2 è già mappato
# nel codice; qui si aggiungono gli altri.
# IBKR_SYMBOL_MAP=AMP2=AMP.MI,XYZ1=XYZ.MI

# Opzionale: TTL della cache del calendario earnings, in secondi. Default 21600 (6h).
# EARNINGS_CACHE_TTL=21600

# Opzionale: collection Mongo dello snapshot IBKR. Default: ibkr_snapshot
# MONGODB_IBKR_COLLECTION=ibkr_snapshot

# --- IBKR Web API (OAuth 1.0a first party) ----------------------------------
# Con queste credenziali l'app legge IBKR da sola e IBKR_SYNC_TOKEN serve solo
# per lanciare la sync a mano. Si generano dal Self-Service Portal:
# Client Portal -> Settings -> API -> OAuth Self-Service.
#
# Consumer key scelto nel portale (9 caratteri, maiuscolo).
IBKR_CONSUMER_KEY=
# Access token e token secret (cifrato, base64) generati dal portale.
IBKR_ACCESS_TOKEN=
IBKR_ACCESS_TOKEN_SECRET=
# Le due chiavi private RSA di cui hai caricato le pubbliche nel portale.
# Sono accettate come PEM multilinea, PEM con i newline resi come \n, o
# l'intero PEM in base64 — comodo per i pannelli web che mangiano gli a-capo.
IBKR_SIGNATURE_KEY=
IBKR_ENCRYPTION_KEY=
# Primo Diffie-Hellman in esadecimale, dal dhparam.pem caricato nel portale:
#   openssl dhparam -outform PEM 2048 -out dhparam.pem
#   openssl dh -in dhparam.pem -text -noout   # il "prime" senza ':' e spazi
IBKR_DH_PRIME=
# IBKR_DH_GENERATOR=2
# limited_poa in produzione; test_realm solo con la consumer key TESTCONS.
# IBKR_REALM=limited_poa
# Opzionale: forza l'account invece di prendere il primo.
# IBKR_ACCOUNT_ID=

# Segreto del cron Vercel. Definendolo, Vercel manda in automatico
# `Authorization: Bearer $CRON_SECRET` a /api/ibkr/cron.
CRON_SECRET=

# SMTP per la mail dell'alert. Con Gmail serve una "password per le app"
# (account Google -> Sicurezza -> Password per le app), non la password vera.
# Se mancano, il job completa lo stesso e manda solo su Telegram.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Destinatario. Se vuoto usa IBKR_SYNC_USER_EMAIL.
# ALERT_EMAIL_TO=
