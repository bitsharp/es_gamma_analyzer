{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "crons": [
    { "path": "/api/ibkr/cron", "schedule": "0 18 * * *" },
    { "path": "/api/zerogex/cron", "schedule": "30 21 * * 1-5" },
    { "path": "/api/insider/cron", "schedule": "30 23 * * 1-5" }
  ]
}
